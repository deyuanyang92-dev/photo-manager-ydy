
/* ══════════════════════════════════════════════════════════════════
   Specimen Imaging Workbench — Theme System
   Auto-generated by app/config/theme.py — do not hand-edit
   Rhythm: 4/8/12/16/20/24 spacing · 8/12/14 radius · 11/12/13/15/18/22 type
   ══════════════════════════════════════════════════════════════════ */

/* ── Global ─────────────────────────────────────────────────────── */
QWidget {
    background-color: #f4f6f8;
    color: #17212b;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "微软雅黑", "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", "Noto Sans SC", "Source Han Sans SC", "WenQuanYi Micro Hei", "Arial", "Calibri", sans-serif;
    font-size: 13px;
    selection-background-color: #0f766e;
    selection-color: #f4f6f8;
}
QMainWindow { background-color: #f4f6f8; }
QWidget#AppShell { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f7f9fb, stop:1 #eef2f5); }
QToolTip {
    background-color: #f5f7fa;
    color: #17212b;
    border: 1px solid rgba(15,23,42,0.13);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Top bar (brand + segmented nav + global actions) ───────────── */
QFrame#TopBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #ffffff);
    border: none;
    border-bottom: 1px solid rgba(15,23,42,0.08);
}
QFrame#TopBarDivider { background: rgba(15,23,42,0.08); border: none; }
QLabel#BrandWord {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "微软雅黑", "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", "Noto Sans SC", "Source Han Sans SC", "WenQuanYi Micro Hei", "Arial", "Calibri", sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #17212b;
    letter-spacing: 0;
}
QLabel#BrandMark { color: #0f766e; }
QWidget#NavWrap { background: transparent; }

/* Segmented navigation — compact command-bar tabs. */
QPushButton#NavSegment {
    background: transparent;
    border: 1px solid transparent;
    color: #475569;
    font-size: 12px;
    font-weight: 500;
    min-height: 32px;
    padding: 0 13px;
    margin: 0 1px;
    border-radius: 8px;
    letter-spacing: 0;
}
QPushButton#NavSegment:hover {
    color: #17212b;
    background-color: rgba(15,118,110,0.06);
    border-color: rgba(15,23,42,0.13);
}
QPushButton#NavSegment:checked {
    color: #0d9488;
    background-color: #e6f5f3;
    border-color: #0f766e;
    font-weight: 600;
}

QToolButton#NavMenuButton {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid rgba(15,23,42,0.13);
    border-radius: 8px;
    padding: 0 10px;
    font-size: 12px;
    font-weight: 600;
}
QToolButton#NavMenuButton:hover {
    color: #0d9488;
    border-color: #0f766e;
    background-color: rgba(15,118,110,0.06);
}
QToolButton#NavMenuButton::menu-indicator {
    image: none;
    width: 0;
}

/* Icon-only ghost buttons (theme toggle / settings cog) */
QPushButton#IconGhost {
    background-color: #ffffff;
    border: 1px solid rgba(15,23,42,0.13);
    border-radius: 8px;
    color: #64748b;
    padding: 0;
}
QPushButton#IconGhost:hover {
    background-color: rgba(15,118,110,0.06);
    border-color: #0f766e;
}
QToolButton#ScreenshotTool {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid rgba(15,23,42,0.13);
    border-radius: 6px;
    padding: 0 8px;
    font-size: 12px;
    font-weight: 600;
}
QToolButton#ScreenshotTool:hover {
    border-color: #0f766e;
    color: #17212b;
    background-color: rgba(15,118,110,0.06);
}
QToolButton#ScreenshotTool::menu-button {
    border: none;
    width: 14px;
}

/* ── Context bar (project switcher + active badge + quick actions) ─ */
QFrame#ContextBar {
    background-color: #f8fafc;
    border: none;
    border-bottom: 1px solid rgba(15,23,42,0.08);
}
QLabel#ContextLabel {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0;
}
QPushButton#ProjectSwitcher {
    background-color: #ffffff;
    border: 1px solid rgba(15,23,42,0.13);
    border-radius: 8px;
    padding: 7px 12px;
    color: #17212b;
    font-size: 12px;
    font-weight: 600;
    text-align: left;
}
QPushButton#ProjectSwitcher:hover {
    border-color: #0f766e;
    background-color: #ffffff;
}
/* 工作区面包屑（EOS Utility 式）：祖先段扁平、叶子似旧 switcher、◀▶ 紧凑 */
QPushButton#CrumbSeg {
    background: transparent;
    border: none;
    padding: 7px 4px;
    color: #64748b;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#CrumbSeg:hover {
    color: #0f766e;
}
QLabel#CrumbSep {
    color: #94a3b8;
    font-size: 12px;
    padding: 0 1px;
}
QPushButton#CrumbLeaf {
    background-color: #ffffff;
    border: 1px solid rgba(15,23,42,0.13);
    border-radius: 8px;
    padding: 7px 11px;
    color: #17212b;
    font-size: 12px;
    font-weight: 600;
    text-align: left;
}
QPushButton#CrumbLeaf:hover {
    border-color: #0f766e;
    background-color: #ffffff;
}
QToolButton#CrumbArrow {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 3px;
    color: #64748b;
    font-size: 11px;
}
QToolButton#CrumbArrow:hover {
    color: #0f766e;
    border-color: rgba(15,23,42,0.08);
}
QToolButton#CrumbArrow:disabled {
    color: #94a3b8;
}
QToolButton#WorkspaceMenuButton,
QToolButton#WorkspaceFolderButton {
    background-color: #ffffff;
    border: 1px solid rgba(15,23,42,0.13);
    border-radius: 8px;
    padding: 0;
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
}
QToolButton#WorkspaceMenuButton:hover,
QToolButton#WorkspaceFolderButton:hover {
    color: #0f766e;
    border-color: #0f766e;
    background-color: rgba(15,118,110,0.06);
}
QToolButton#WorkspaceFolderButton::menu-button {
    border: none;
    width: 0;
}
QLabel#ActiveBadgeOn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #14b8a6, stop:1 #0f766e);
    color: #f4f6f8;
    border-radius: 999px;
    padding: 5px 14px;
    font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0;
}
QLabel#ActiveBadgeOff {
    background-color: #eef2f6;
    color: #94a3b8;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 999px;
    padding: 4px 14px;
    font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
    font-size: 12px;
    font-weight: 500;
}

QStackedWidget { background: transparent; border: none; }

/* ── Workspace header ────────────────────────────────────────────── */
QLabel#WorkspaceTitle {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "微软雅黑", "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", "Noto Sans SC", "Source Han Sans SC", "WenQuanYi Micro Hei", "Arial", "Calibri", sans-serif;
    font-size: 18px;
    font-weight: 500;
    color: #17212b;
    letter-spacing: 0;
}
QLabel#WorkbenchTitle {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "微软雅黑", "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", "Noto Sans SC", "Source Han Sans SC", "WenQuanYi Micro Hei", "Arial", "Calibri", sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #17212b;
    letter-spacing: 0;
}
QLabel#WorkbenchCount {
    color: #64748b;
    font-size: 12px;
    font-weight: 500;
}
QLabel#WorkbenchSubTitle {
    color: #334155;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0;
}
QLabel#WorkbenchHint {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0;
}
QLabel#TagSea, QLabel#TagWarn, QLabel#TagOk {
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0;
}
QLabel#TagSea { background-color: rgba(15,118,110,0.11); color: #0d9488; }
QLabel#TagWarn { background-color: rgba(180,83,9,0.11); color: #b45309; }
QLabel#TagOk { background-color: rgba(21,128,61,0.11); color: #15803d; }

/* ── Directory info strip ────────────────────────────────────────── */
QFrame#DirStrip {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #f3f6f8);
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 8px;
}
QLabel#DirLabel {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0;
}
QLabel#DirPath {
    font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
    font-size: 11px;
    color: #64748b;
    background-color: transparent;
    border-radius: 6px;
    padding: 2px 0;
}

/* ── Panels / cards / sections ───────────────────────────────────── */
/* Cards: vertical surface gradient + faint hairline + 1px inner top lip. */
QFrame#WorkflowDashboard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #f3f6f8);
    border: 1px solid rgba(15,23,42,0.13);
    border-radius: 8px;
}
QLabel#WorkflowDashEyebrow {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0;
}
QLabel#WorkflowDashTitle {
    color: #17212b;
    font-size: 15px;
    font-weight: 600;
}
QLabel#WorkflowDashDetail {
    color: #64748b;
    font-size: 12px;
}
QFrame#WorkflowDashMetric {
    background: transparent;
    border-left: 1px solid rgba(15,23,42,0.08);
}
QLabel#WorkflowDashMetricLabel {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 500;
}
QLabel#WorkflowDashMetricValue {
    color: #334155;
    font-size: 12px;
    font-weight: 600;
}

QFrame#Panel, QFrame#WorkbenchSection, QFrame#PanelCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:0.06 #ffffff, stop:1 #fbfcfd);
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 10px;
}
QFrame#WorkbenchSection {
    border-color: rgba(15,23,42,0.13);
}

/* ── System-like file rows: incoming-jpg/ and results/ ───────────── */
QFrame#Card {
    background: #ffffff;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 4px;
}
QFrame#ResultFile {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
}
QFrame#ResultFile[resultViewMode="large_thumbnail"] {
    background: #f8fafc;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 4px;
}
QFrame#ResultFile[resultViewMode="large_thumbnail"] QLabel#Mono {
    background: transparent;
    padding: 1px 4px;
}
QFrame#ResultRow {
    background: transparent;
    border: none;
}
QLabel#ResultSeqBadge {
    color: #94a3b8;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
}
QFrame#ResultRow[pairedColumns="false"] QLabel#ResultSeqBadge {
    background: #f8fafc;
    border-color: rgba(15,23,42,0.08);
}
QFrame#ResultPlaceholder {
    background: #f8fafc;
    border: 1px dashed rgba(15,23,42,0.13);
    border-radius: 4px;
}
QFrame#Card:hover {
    background: #eef6ff;
    border-color: rgba(15,23,42,0.13);
}
QFrame#ResultFile:hover {
    background: #eef6ff;
    border-color: rgba(15,23,42,0.08);
}
QFrame#CardSelected {
    background: #d7ebff;
    border: 1px solid #1d6fd1;
    border-left: 5px solid #1d6fd1;
    border-radius: 4px;
}
QFrame#Card[resultSelected="true"] {
    background: #d7ebff;
    border: 1px solid #1d6fd1;
    border-left: 5px solid #1d6fd1;
    border-radius: 4px;
}
QFrame#ResultFile[resultSelected="true"] {
    background: #d7ebff;
    border: 1px solid #1d6fd1;
    border-left: 3px solid #1d6fd1;
    border-radius: 4px;
}
QFrame#CardSelected QLabel#Mono,
QFrame#Card[resultSelected="true"] QLabel#Mono,
QFrame#ResultFile[resultSelected="true"] QLabel#Mono {
    color: #1d6fd1;
    font-weight: 700;
}
QLabel#ResultMeta {
    color: #94a3b8;
    font-size: 11px;
}
QLabel#FileSelectMark {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    color: transparent;
    font-size: 12px;
    font-weight: 900;
}
QLabel#FileSelectMark[selected="true"] {
    background: #1d6fd1;
    border-color: #1d6fd1;
    color: #ffffff;
}
QLabel#ResultSelectBadge {
    border: 1px solid rgba(15,23,42,0.22);
    border-radius: 3px;
    background: #ffffff;
    color: transparent;
    font-size: 11px;
    font-weight: 700;
}
QLabel#ResultSelectBadge[selected="true"] {
    background: #1d6fd1;
    border-color: #1d6fd1;
    color: #ffffff;
}
QFrame#ResultPairIndicator {
    background: transparent;
    border: none;
}
QFrame#ResultPairLine {
    background: rgba(15,23,42,0.13);
    border: none;
}
QFrame#ResultPairLine[hasPair="false"] {
    background: transparent;
}
QFrame#ResultPairLine[selected="true"] {
    background: #1d6fd1;
}
QLabel#ResultPairArrow {
    color: #64748b;
    background: transparent;
    border: none;
    font-size: 12px;
    font-weight: 600;
}
QLabel#ResultPairArrow[hasPair="false"] {
    color: transparent;
    background: transparent;
    border-color: transparent;
}
QLabel#ResultPairArrow[selected="true"] {
    color: #1d6fd1;
    background: transparent;
    border-color: transparent;
}
QLabel#FileThumb {
    background: #f8fafc;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 4px;
    padding: 1px;
}
QLabel#FileThumb[hasThumbnail="true"] {
    background: #ffffff;
    border-color: rgba(15,23,42,0.13);
}
QLabel#FileName,
QFrame#ResultFile QLabel#Mono,
QFrame#ResultGroupHeader QLabel#Mono {
    font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
    font-size: 12px;
    color: #334155;
    background: transparent;
    border: none;
    padding: 0;
}
QLabel#FileName {
    font-weight: 500;
    color: #17212b;
}
QFrame#ResultFile QLabel#Mono {
    font-weight: 500;
}
QLabel#FileUid,
QLabel#FileUidActive,
QLabel#FileUidMissing,
QLabel#FileUidMuted,
QLabel#FileStateRaw,
QLabel#FileStateTiff,
QLabel#FileStateArchived,
QLabel#FileStateComposed {
    border-radius: 3px;
    font-size: 11px;
    font-weight: 500;
    padding: 1px 7px;
    letter-spacing: 0;
}
QLabel#FileUid {
    font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
    color: #115e59;
    background: transparent;
    border: none;
    padding: 1px 2px;
}
QLabel#FileUidActive {
    font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
    color: #0f766e;
    background: transparent;
    border: none;
    padding: 1px 2px;
    font-weight: 600;
}
QLabel#FileUidMissing {
    color: #b45309;
    background: rgba(180,83,9,0.11);
    border: 1px solid rgba(180,83,9,0.22);
}
QLabel#FileUidMuted {
    font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
    color: #64748b;
    background: transparent;
    border: none;
    padding: 1px 2px;
}
QLabel#FileStateRaw {
    color: #b45309;
    background: transparent;
    border: 1px solid rgba(180,83,9,0.18);
}
QLabel#FileStateTiff {
    color: #15803d;
    background: transparent;
    border: 1px solid rgba(21,128,61,0.20);
}
QLabel#FileStateArchived {
    color: #64748b;
    background: transparent;
    border: 1px solid rgba(15,23,42,0.08);
}
QLabel#FileStateComposed {
    color: #2563eb;
    background: transparent;
    border: 1px solid rgba(37,99,235,0.20);
}
QFrame#CardSelected QLabel#FileName,
QFrame#Card[resultSelected="true"] QLabel#FileName {
    color: #1d6fd1;
    font-weight: 600;
}
QFrame#ResultGroupHeader QLabel#Mono {
    font-weight: 600;
    color: #334155;
}

QFrame#NamingGroup {
    background: #f8fafc;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 8px;
}
QFrame#NamingPreviewGroup {
    background: rgba(15,118,110,0.06);
    border: 1px solid rgba(15,118,110,0.24);
    border-radius: 8px;
}
QLabel#NamingGroupTitle {
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0;
}
QLabel#CompactFieldLabel {
    color: #334155;
    font-size: 11px;
    font-weight: 500;
}
QToolButton#CompactIconButton {
    background: transparent;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 6px;
    padding: 3px;
}
QToolButton#CompactIconButton:hover {
    background: rgba(15,118,110,0.06);
    border-color: #0f766e;
}
QFrame#BatchIdentBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #f3f6f8);
    border: 1px solid rgba(15,23,42,0.13);
    border-top: 1px solid rgba(255,255,255,0.72);
    border-radius: 8px;
    min-height: 36px;
}
QFrame#WorkbenchSelectionBar {
    background-color: #f8fafc;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 6px;
}
QLabel#WorkbenchSelectionText {
    color: #64748b;
    font-size: 11px;
    font-weight: 500;
}
QFrame#Divider { background-color: rgba(15,23,42,0.08); max-height: 1px; min-height: 1px; border: none; }

/* ── Grouping tool popup (分组工具) ─────────────────────────────────── */
/* Soft-gray dialog bg lets the inner WorkbenchSection card's shadow breathe
   (the popup host pads the layout so the shadow is no longer clipped). */
QDialog#GroupingDialog { background-color: #f4f6f8; }
/* Draft-group JPG drop zone: dashed inset when empty, hairline white when filled. */
QListWidget#GroupDropZoneEmpty {
    background-color: #eef2f6;
    border: 1px dashed rgba(15,23,42,0.22);
    border-radius: 6px;
}
QListWidget#GroupDropZone {
    background-color: #ffffff;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 6px;
}
/* Per-group accent chips (cycle blue/green/teal/amber by index). Light-tint
   literal convention matches the existing ChipRaw/ChipAttribated rules; the
   objectName GroupChipN is set in _DraftGroupRow._setup_ui. */
QLabel#GroupChip0, QLabel#GroupChip1, QLabel#GroupChip2, QLabel#GroupChip3 {
    border-radius: 999px;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 10px;
    letter-spacing: 0;
}
QLabel#GroupChip0 { background-color: rgba(37,99,235,0.10); color: #2563eb; }
QLabel#GroupChip1 { background-color: rgba(21,128,61,0.11); color: #15803d; }
QLabel#GroupChip2 { background-color: rgba(15,118,110,0.12); color: #0f766e; }
QLabel#GroupChip3 { background-color: rgba(180,83,9,0.11); color: #b45309; }

/* ── Project settings drawer (right-edge overlay) + backdrop scrim ─── */
QWidget#SettingsDrawer {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:0.06 #ffffff, stop:1 #fbfcfd);
    border-left: 1px solid rgba(15,23,42,0.08);
}
QWidget#DrawerScrim { background: rgba(4, 11, 14, 0.55); }

/* ── Labels ──────────────────────────────────────────────────────── */
QLabel { background: transparent; color: #17212b; }
QLabel#Muted { color: #64748b; }
QLabel#MutedSmall { color: #94a3b8; font-size: 11px; }
QLabel#Accent { color: #0f766e; }
QLabel#Title { font-family: "Microsoft YaHei UI", "Microsoft YaHei", "微软雅黑", "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", "Noto Sans SC", "Source Han Sans SC", "WenQuanYi Micro Hei", "Arial", "Calibri", sans-serif; font-size: 20px; font-weight: 600; color: #17212b; }
QLabel#Section, QLabel#CardTitle {
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 0;
}
QLabel#Placeholder { color: #64748b; font-size: 15px; }
QLabel#EmptyState {
    color: #64748b;
    background-color: #f8fafc;
    border: 1px dashed rgba(15,23,42,0.13);
    border-radius: 8px;
    padding: 26px 28px;
    font-size: 12px;
    line-height: 1.5;
}

QLabel#BatchUid {
    font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
    color: #0d9488;
    font-size: 12px;
    font-weight: 500;
}
QLabel#ActivateState {
    color: #94a3b8;
    font-size: 11px;
    padding: 3px 11px;
    border-radius: 999px;
    background-color: #eef2f6;
    border: 1px solid rgba(15,23,42,0.08);
}
QLabel#ActivateStateOn {
    color: #0d9488;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 11px;
    border-radius: 999px;
    background-color: rgba(15,118,110,0.11);
    border: 1px solid rgba(15,118,110,0.24);
}
QLabel#StatValue { font-size: 20px; font-weight: 700; color: #17212b; }
QLabel#StatLabel { font-size: 11px; color: #94a3b8; letter-spacing: 0; }

/* ── Collaboration centre ───────────────────────────────────────── */
QFrame#CollabHeader {
    background-color: #ffffff;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 8px;
}
QLabel#CollabTitle {
    color: #17212b;
    font-size: 18px;
    font-weight: 700;
}
QLabel#CollabScope {
    color: #64748b;
    font-size: 12px;
}
QLabel#CollabStatusBadge,
QLabel#CollabMetric,
QLabel#CollabMetricDanger {
    border-radius: 999px;
    padding: 4px 11px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#CollabStatusBadge {
    background-color: #eef2f6;
    color: #334155;
    border: 1px solid rgba(15,23,42,0.08);
}
QLabel#CollabMetric {
    background-color: #f8fafc;
    color: #64748b;
    border: 1px solid rgba(15,23,42,0.08);
}
QLabel#CollabMetricDanger {
    background-color: rgba(180,35,24,0.10);
    color: #b42318;
    border: 1px solid rgba(230,110,99,0.45);
}
QFrame#CollabGuide {
    background-color: rgba(15,118,110,0.11);
    border: 1px solid rgba(15,118,110,0.24);
    border-radius: 8px;
}
QLabel#CollabGuideTitle {
    color: #17212b;
    font-size: 15px;
    font-weight: 700;
}
QLabel#CollabGuideDetail {
    color: #334155;
    font-size: 12px;
}
QFrame#CollabStepPanel {
    background-color: #ffffff;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 8px;
}
QFrame#CollabStepPanel[role="entry"] {
    border-color: rgba(15,118,110,0.24);
}
QFrame#CollabOptionalPanel {
    background-color: #f8fafc;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 8px;
}
QLabel#CollabEntryBadge {
    color: #0f766e;
    background-color: rgba(15,118,110,0.11);
    border: 1px solid rgba(15,118,110,0.24);
    border-radius: 6px;
    padding: 2px 7px;
    font-size: 12px;
    font-weight: 700;
}
QLabel#CollabStepBadge {
    color: #0f766e;
    background-color: rgba(15,118,110,0.11);
    border: 1px solid rgba(15,118,110,0.24);
    border-radius: 11px;
    font-size: 12px;
    font-weight: 700;
}
QLabel#CollabStepTitle {
    color: #17212b;
    font-size: 15px;
    font-weight: 700;
}
QLabel#CollabStepDetail {
    color: #64748b;
    font-size: 12px;
}
QLabel#ConflictBanner {
    background-color: #b42318;
    color: #f4f6f8;
    padding: 8px 12px;
    border-radius: 6px;
    font-weight: 700;
}
QFrame#ManualConnectFrame,
QFrame#DebugDrawer {
    background-color: #ffffff;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 6px;
}
QComboBox#ProjectFilterCombo {
    min-height: 28px;
}

/* ── 5-state attribution chips ─────────────────────────────────── */
QLabel#ChipRaw, QLabel#ChipAttributed, QLabel#ChipComposed,
QLabel#ChipArchived, QLabel#ChipTiff, QLabel#ChipUnattributed {
    border-radius: 999px;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 10px;
    letter-spacing: 0;
}
QLabel#ChipRaw { background-color: rgba(180,83,9,0.11); color: #b45309; }
QLabel#ChipAttributed { background-color: rgba(21,128,61,0.11); color: #15803d; }
QLabel#ChipComposed { background-color: rgba(37,99,235,0.10); color: #2563eb; }
QLabel#ChipArchived { background-color: rgba(135,162,161,0.16); color: #64748b; }
QLabel#ChipTiff { background-color: rgba(21,128,61,0.11); color: #15803d; }
QLabel#ChipUnattributed { background-color: rgba(180,35,24,0.10); color: #b42318; }

/* ── Buttons (height 32-34, unified radius, micro-gradient) ───────── */
QPushButton {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid rgba(15,23,42,0.13);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #ffffff;
    border-color: rgba(15,23,42,0.22);
    color: #17212b;
}
QPushButton:pressed { background-color: #f5f7fa; }
QPushButton:disabled { color: #94a3b8; border-color: rgba(15,23,42,0.08); background-color: #ffffff; }

QPushButton#Primary {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #14b8a6, stop:1 #0f766e);
    color: #f4f6f8;
    border: 1px solid #0f766e;
    border-top: 1px solid #14b8a6;
    font-weight: 600;
}
QPushButton#Primary:hover { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0d9488, stop:1 #0f766e); border-color: #0d9488; }
QPushButton#Primary:pressed { background-color: #115e59; }
QPushButton#Primary:disabled { background: #ffffff; color: #94a3b8; border-color: rgba(15,23,42,0.08); }

QPushButton#Outline {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid rgba(15,23,42,0.13);
}
QPushButton#Outline:hover { border-color: #0f766e; color: #17212b; background-color: rgba(15,118,110,0.06); }

QPushButton#Ghost {
    background-color: transparent;
    border: 1px solid transparent;
    color: #64748b;
    padding: 6px 10px;
}
QPushButton#Ghost:hover { color: #17212b; background-color: #e6f5f3; }

QPushButton#Danger { background-color: transparent; color: #b42318; border: 1px solid rgba(230,110,99,0.45); }
QPushButton#Danger:hover { background-color: #b42318; color: #f4f6f8; border-color: #b42318; }
QPushButton#Danger:disabled { color: #94a3b8; border-color: rgba(15,23,42,0.08); background: transparent; }

/* ── Phase pills ─────────────────────────────────────────────────── */
QPushButton#PhasePill, QPushButton#PhasePillActive {
    border-radius: 999px;
    padding: 2px 12px;
    font-size: 11px;
    font-weight: 500;
}
QPushButton#PhasePill {
    background-color: transparent;
    color: #64748b;
    border: 1px solid rgba(15,23,42,0.13);
}
QPushButton#PhasePill:hover { color: #334155; border-color: rgba(15,23,42,0.22); }
QPushButton#PhasePill:checked, QPushButton#PhasePillActive:checked, QPushButton#PhasePillActive {
    background-color: rgba(15,118,110,0.11);
    color: #0f766e;
    border: 1px solid #0f766e;
}

/* ── Sidebar per-编号 phase dots ─────────────────────────────────────
   4 round dots under each specimen UID = 拍摄中/已拍完/整理中/完成.
   Always show the phase colour as a ring; the current phase fills.
   Colours reuse per-theme semantic tokens so they track the active theme:
   蓝 info=shooting · 青 accent=shot_done · 橙 warn=organizing · 绿 success=done. */
QPushButton#PhaseDotShooting, QPushButton#PhaseDotShotDone,
QPushButton#PhaseDotOrganizing, QPushButton#PhaseDotDone {
    min-width: 12px; max-width: 12px;
    min-height: 12px; max-height: 12px;
    padding: 0px;
    border-radius: 6px;
    background-color: transparent;
}
QPushButton#PhaseDotShooting   { border: 2px solid #2563eb; }
QPushButton#PhaseDotShotDone   { border: 2px solid #0f766e; }
QPushButton#PhaseDotOrganizing { border: 2px solid #b45309; }
QPushButton#PhaseDotDone       { border: 2px solid #15803d; }
QPushButton#PhaseDotShooting:hover   { background-color: rgba(37,99,235,0.10); }
QPushButton#PhaseDotShotDone:hover   { background-color: rgba(15,118,110,0.11); }
QPushButton#PhaseDotOrganizing:hover { background-color: rgba(180,83,9,0.11); }
QPushButton#PhaseDotDone:hover       { background-color: rgba(21,128,61,0.11); }
QPushButton#PhaseDotShooting:checked   { background-color: #2563eb; }
QPushButton#PhaseDotShotDone:checked   { background-color: #0f766e; }
QPushButton#PhaseDotOrganizing:checked { background-color: #b45309; }
QPushButton#PhaseDotDone:checked       { background-color: #15803d; }

QPushButton#Tiny { padding: 3px 11px; font-size: 11px; border-radius: 6px; }

/* ── Sidebar collab-status strip ────────────────────────────────────── */
QFrame#CollabStrip {
    background-color: #f8fafc;
    border: 1px solid rgba(15,23,42,0.08);
    border-top: 1px solid rgba(255,255,255,0.45);
    border-radius: 6px;
    margin-top: 8px;
}

/* ── Storage-mode button group ─────────────────────────────────────── */
QPushButton#StorageBtn {
    background-color: #eef2f6;
    color: #64748b;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 500;
    font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
}
QPushButton#StorageBtn:hover {
    border-color: #0f766e;
    color: #17212b;
    background-color: rgba(15,118,110,0.06);
}
QPushButton#StorageBtn:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #14b8a6, stop:1 #0f766e);
    color: #f4f6f8;
    border-color: #0f766e;
    font-weight: 600;
}

/* ── Drop target ─────────────────────────────────────────────────── */
QPushButton#DropTarget {
    background-color: #eef2f6;
    border: 1px dashed rgba(15,23,42,0.22);
    border-radius: 8px;
    color: #0d9488;
    font-weight: 600;
    padding: 10px 14px;
}
QPushButton#DropTarget:hover { border-color: #0f766e; background-color: rgba(15,118,110,0.11); }
QPushButton#DropTarget:disabled { color: #94a3b8; border-color: rgba(15,23,42,0.08); }

/* ── Inputs ──────────────────────────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox {
    background-color: #ffffff;
    color: #17212b;
    border: 1px solid rgba(15,23,42,0.14);
    border-radius: 6px;
    padding: 6px 9px;
    font-size: 13px;
    selection-background-color: #0f766e;
    selection-color: #f4f6f8;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover { border-color: rgba(15,23,42,0.13); }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus {
    border-color: #0f766e;
}
QLineEdit:disabled { color: #64748b; background-color: #f4f6f8; }
QLineEdit#AutoField {
    background-color: #f8fafc;
    color: #64748b;
    border: 1px solid rgba(15,23,42,0.14);
}
QLineEdit#MonoInput { font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace; }
QLineEdit#StorageDisplay {
    background-color: #f8fafc;
    color: #17212b;
    border: 1px solid rgba(15,23,42,0.14);
}
QLineEdit#StorageDisplay:focus { border-color: rgba(15,23,42,0.14); }

/* ── Preview blocks ──────────────────────────────────────────────── */
QLabel#PreviewBlock {
    font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
    font-size: 13px;
    color: #0d9488;
    background-color: #ffffff;
    border: 1px solid rgba(15,118,110,0.24);
    border-radius: 6px;
    padding: 10px 12px;
}
QLabel#PreviewEmpty {
    font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
    font-size: 13px;
    color: #94a3b8;
    background-color: #eef2f6;
    border: 1px dashed rgba(15,23,42,0.08);
    border-radius: 6px;
    padding: 10px 12px;
}
QLabel#RnaWarning {
    color: #b45309;
    background-color: rgba(180,83,9,0.11);
    border: 1px solid rgba(241,189,87,0.30);
    border-radius: 6px;
    padding: 8px 11px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#UnattributedWarning {
    color: #b45309;
    background-color: rgba(180,83,9,0.11);
    border: 1px solid rgba(241,189,87,0.26);
    border-radius: 6px;
    padding: 7px 11px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#TargetName {
    font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
    color: #15803d;
    font-size: 13px;
    font-weight: 600;
}

/* ── ComboBox ────────────────────────────────────────────────────── */
QComboBox {
    background-color: #ffffff;
    color: #17212b;
    border: 1px solid rgba(15,23,42,0.14);
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
}
QComboBox:hover { border-color: rgba(15,23,42,0.13); }
QComboBox:focus { border-color: #0f766e; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #17212b;
    border: 1px solid rgba(15,23,42,0.13);
    border-radius: 6px;
    selection-background-color: #e6f5f3;
    selection-color: #0f766e;
    padding: 4px;
    outline: none;
}
QSpinBox::up-button, QSpinBox::down-button { width: 16px; border: none; background: #eef2f6; }

/* ── Scrollbars ──────────────────────────────────────────────────── */
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; border: none; }
QScrollBar::handle:vertical { background: #cbd5e1; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #0f766e; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; border: none; }
QScrollBar::handle:horizontal { background: #cbd5e1; border-radius: 5px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #0f766e; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* Top-bar nav scroll: slim horizontal bar so overflow scrolling stays unobtrusive. */
QScrollArea#NavScroll QScrollBar:horizontal { height: 5px; background: transparent; margin: 0; }
QScrollArea#NavScroll QScrollBar::handle:horizontal { background: rgba(15,23,42,0.22); border-radius: 2px; min-width: 28px; }
QScrollArea#NavScroll QScrollBar::handle:horizontal:hover { background: #0f766e; }

QScrollArea#RightRailScroll {
    background-color: #f8fafc;
    border-left: 2px solid rgba(15,23,42,0.22);
    border-top: none;
    border-right: 1px solid rgba(15,23,42,0.13);
    border-bottom: none;
}
QWidget#RightRailContent {
    background-color: #f8fafc;
}
QScrollArea#RightRailScroll QScrollBar:vertical {
    background: #ffffff;
    width: 14px;
    margin: 0;
    border-left: 1px solid rgba(15,23,42,0.13);
}
QScrollArea#RightRailScroll QScrollBar::handle:vertical {
    background: rgba(15,23,42,0.22);
    border-radius: 5px;
    min-height: 44px;
    margin: 2px;
}
QScrollArea#RightRailScroll QScrollBar::handle:vertical:hover {
    background: #0f766e;
}

/* ── Splitter ────────────────────────────────────────────────────── */
QSplitter#WorkbenchSplitter::handle:horizontal {
    width: 14px;
    background-color: #eef2f6;
    border-left: 1px solid rgba(15,23,42,0.13);
    border-right: 1px solid rgba(15,23,42,0.13);
}
QSplitter#WorkbenchSplitter::handle:horizontal:hover {
    background-color: rgba(15,118,110,0.11);
    border-left-color: rgba(15,118,110,0.24);
    border-right-color: rgba(15,118,110,0.24);
}
QSplitter#WorkbenchSplitter::handle:horizontal:pressed {
    background-color: rgba(15,118,110,0.24);
}
QSplitter#WorkbenchVerticalSplitter::handle:vertical {
    height: 14px;
    background-color: #eef2f6;
    border-top: 1px solid rgba(15,23,42,0.13);
    border-bottom: 1px solid rgba(15,23,42,0.13);
}
QSplitter#WorkbenchVerticalSplitter::handle:vertical:hover {
    background-color: rgba(15,118,110,0.11);
    border-top-color: rgba(15,118,110,0.24);
    border-bottom-color: rgba(15,118,110,0.24);
}
QSplitter#WorkbenchVerticalSplitter::handle:vertical:pressed {
    background-color: rgba(15,118,110,0.24);
}
QSplitter::handle { background-color: transparent; }
QSplitter::handle:hover { background-color: rgba(15,118,110,0.06); border-radius: 2px; }
QSplitter::handle:horizontal { width: 12px; }
QSplitter::handle:vertical { height: 12px; }

/* ── Right-rail tabs ──────────────────────────────────────────────── */
QTabWidget#RightRailTabs::pane {
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 10px;
    background: #f8fafc;
    top: -1px;
}
QTabWidget#RightRailTabs > QTabBar { qproperty-drawBase: 0; }
QTabWidget#RightRailTabs QTabBar::tab {
    color: #64748b;
    background: transparent;
    border: 1px solid transparent;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 16px;
    margin-right: 4px;
    font-size: 13px;
}
QTabWidget#RightRailTabs QTabBar::tab:hover { color: #334155; }
QTabWidget#RightRailTabs QTabBar::tab:selected {
    color: #0f766e;
    background: #f8fafc;
    border-color: rgba(15,23,42,0.08);
    border-bottom-color: #f8fafc;
    font-weight: 600;
}

/* ── Specimen list ───────────────────────────────────────────────── */
QListWidget#SpecimenList {
    background-color: #f8fafc;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 8px;
    alternate-background-color: transparent;
    outline: none;
    padding: 6px;
}
QListWidget#SpecimenList::item {
    color: #334155;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0px;
    margin: 3px 0;
}
QListWidget#SpecimenList::item:hover { background-color: transparent; }
QListWidget#SpecimenList::item:selected {
    background-color: transparent;
    border: 1px solid transparent;
    color: #17212b;
}
QFrame#SpecimenRow {
    background-color: #ffffff;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 6px;
    margin: 1px 0;
}
QFrame#SpecimenRowActive {
    background-color: #e6f5f3;
    border: 2px solid #0f766e;
    border-left: 6px solid #0f766e;
    border-radius: 6px;
    margin: 1px 0;
}
QFrame#SpecimenRow:hover {
    background-color: #ffffff;
    border-color: rgba(15,118,110,0.24);
}
QFrame#SpecimenRowActive:hover {
    background-color: #e6f5f3;
    border-color: rgba(15,118,110,0.24);
    border-left: 6px solid #0f766e;
}
QFrame#SpecimenRow[selected="true"],
QFrame#SpecimenRowActive[selected="true"] {
    background-color: #e6f5f3;
    border: 2px solid #0f766e;
    border-left: 6px solid #0f766e;
}
QLabel#SpecimenUid {
    font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
    color: #17212b;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0;
}
QLabel#SpecimenSubtext {
    color: #64748b;
    font-size: 12px;
    font-weight: 400;
}
QLabel#SpecimenMissingText {
    color: #64748b;
    background-color: transparent;
    border: none;
    padding: 0px;
    font-size: 11px;
    font-weight: 500;
}
QLabel#SpecimenBadge {
    color: #0d9488;
    background-color: rgba(15,118,110,0.11);
    border: 1px solid rgba(15,118,110,0.24);
    border-radius: 999px;
    padding: 1px 7px;
    font-size: 11px;
    font-weight: 500;
}
QLabel#SpecimenRnaBadge {
    color: #0f766e;
    background-color: rgba(20, 184, 166, 0.14);
    border: 1px solid rgba(15, 118, 110, 0.28);
    border-radius: 6px;
    padding: 1px 6px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#SpecimenProgressBadge {
    color: #15803d;
    background-color: rgba(21,128,61,0.11);
    border: 1px solid #15803d;
    border-radius: 6px;
    padding: 1px 6px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#SpecimenStorageText {
    color: #64748b;
    font-size: 11px;
    font-weight: 500;
}
QLabel#SpecimenActivePill {
    color: #f4f6f8;
    background-color: #0f766e;
    border-radius: 6px;
    padding: 1px 6px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#SpecimenInactivePill {
    color: #64748b;
    background-color: #f8fafc;
    border: 1px solid rgba(15,23,42,0.13);
    border-radius: 6px;
    padding: 1px 6px;
    font-size: 11px;
    font-weight: 500;
}
QPushButton#SpecimenPrintButton {
    background-color: transparent;
    border: 1px solid rgba(15,23,42,0.13);
    border-radius: 6px;
    padding: 0px;
}
QPushButton#SpecimenPrintButton:hover {
    background-color: rgba(15,118,110,0.11);
    border-color: #0f766e;
}
QPushButton#SpecimenPrintButton:pressed {
    background-color: #0f766e;
}

/* ── Generic list ────────────────────────────────────────────────── */
QListWidget {
    background-color: #ffffff;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 6px;
    alternate-background-color: #f8fafc;
    outline: none;
    padding: 3px;
}
QListWidget::item { padding: 4px 8px; border-radius: 6px; color: #334155; }
QListWidget::item:hover { background-color: #ffffff; }
QListWidget::item:selected { background-color: #e6f5f3; color: #0f766e; }

/* ── Status bar ──────────────────────────────────────────────────── */
QStatusBar {
    background-color: #edf2f7;
    color: #64748b;
    border-top: 1px solid rgba(15,23,42,0.08);
    font-size: 11px;
    padding: 2px 10px;
}
QStatusBar::item { border: none; }
QLabel#StatusSegment { color: #64748b; padding: 0 10px; font-size: 11px; }
QLabel#StatusSegmentAccent { color: #0f766e; padding: 0 10px; font-size: 11px; }

/* ── Mono label (file paths / UIDs) ──────────────────────────────── */
QLabel#Mono {
    font-family: "JetBrains Mono", "Cascadia Code", "SF Mono", "Consolas", "Courier New", "DejaVu Sans Mono", monospace;
    font-size: 12px;
    color: #334155;
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
}

/* ── Menu ────────────────────────────────────────────────────────── */
QMenu {
    background-color: #ffffff;
    color: #17212b;
    border: 1px solid rgba(15,23,42,0.13);
    border-radius: 6px;
    padding: 6px;
}
QMenu::item { padding: 7px 22px; border-radius: 6px; }
QMenu::item:selected { background-color: #e6f5f3; color: #0f766e; }
QMenu::separator { height: 1px; background-color: rgba(15,23,42,0.08); margin: 5px 8px; }

/* ── CheckBox ────────────────────────────────────────────────────── */
QCheckBox, QRadioButton { color: #334155; spacing: 8px; font-size: 13px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 1px solid rgba(15,23,42,0.13);
    border-radius: 5px;
    background-color: #ffffff;
}
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #0f766e; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background-color: #0f766e; border-color: #0f766e; }

/* ── Table / Tree ────────────────────────────────────────────────── */
QTableWidget, QTableView, QTreeView {
    background-color: #ffffff;
    color: #17212b;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 6px;
    gridline-color: rgba(15,23,42,0.08);
    alternate-background-color: #f8fafc;
    selection-background-color: #e6f5f3;
    selection-color: #0f766e;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #64748b;
    border: none;
    border-bottom: 1px solid rgba(15,23,42,0.08);
    padding: 6px 11px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0;
}

/* ── Slider ──────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    height: 4px;
    background: rgba(15,23,42,0.13);
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #0f766e;
    border-radius: 2px;
    height: 4px;
}
QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: #0f766e;
    border: 2px solid #ffffff;
}
QSlider::handle:horizontal:hover {
    background: #0d9488;
}
QSlider::handle:horizontal:pressed {
    background: #115e59;
}
